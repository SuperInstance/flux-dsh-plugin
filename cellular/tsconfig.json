{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "cell-cascade/*": ["../../cell-cascade/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
